# PlanBound — variable NAMES only. Copy to .env.local and fill with YOUR OWN resources.
# This project is open source: nothing here is our infrastructure, and no value is ever
# committed. Every identifier below resolves from env so a cloner brings their own.

# --- App ---
APP_URL=http://localhost:3000

# --- Supabase (your project: supabase.com/dashboard → Project Settings → API) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Hedera testnet (portal.hedera.com → Testnet; DER or 64-hex private key) ---
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
# Policy co-signer — generate with: pnpm keygen HEDERA_POLICY_KEY
HEDERA_POLICY_KEY=
# Created once by the app at T7; paste the topic id back here.
HCS_TOPIC_ID=
# Hosted x402 facilitator that settles hedera:testnet (keyless).
HEDERA_FACILITATOR_URL=https://api.testnet.blocky402.com

# --- EVM purchase rails (Worldchain primary, Base fallback) ---
WORLDCHAIN_RPC_URL=https://worldchain-mainnet.g.alchemy.com/public
BASE_RPC_URL=https://mainnet.base.org
# Funds per-plan wallets. Generate with: pnpm keygen EVM_TREASURY_KEY
EVM_TREASURY_KEY=
# Hard gate: real mainnet spends are impossible until this is exactly "true".
MAINNET_PAY=false

# --- Agent side (local MCP server only) ---
PLANBOUND_API_URL=http://localhost:3000
PLANBOUND_AGENT_TOKEN=
# Agent's own key — never leaves the dev machine. pnpm keygen AGENT_EVM_KEY
AGENT_EVM_KEY=

# --- The Graph (thegraph.com/studio → deploy subgraph/ → copy the query URL) ---
# Powers the console's claimed-vs-settled panel and GET /api/mcp/seller-trust.
# Unset is a supported state: both surfaces say so rather than falling back to our own DB.
# Treated as a secret — gateway URLs carry an API key in the path.
SUBGRAPH_URL=

# --- Human step-up verification (pluggable; `none` is the default and always works) ---
# `none` = the approval link is the whole factor. `world` = World ID above the threshold.
HUMAN_VERIFIER=none
# Plans above this USD ceiling require human step-up verification.
STEP_UP_USD=5

# --- World ID 4.0, Managed (developer.world.org → your app → Enable World ID 4.0) ---
# Registration hands over three values. app_id is public; the signer key never is.
WORLD_APP_ID=
WORLD_RP_ID=
WORLD_SIGNER_KEY=
# staging pairs with the World ID simulator; production with a real World App.
WORLD_ENV=staging
# The action must exist in the Portal *in this environment*, or scans do nothing.
WORLD_ACTION=planbound-approve-plan
# proofOfHuman (default) · selfieCheckLegacy (preview, needs app-level enablement) · passport
WORLD_PRESET=proofOfHuman

# --- Demo conversion (fixed rate so demo numbers are stable and stated) ---
DEMO_USD_PER_HBAR=0.07
